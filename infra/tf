#!/usr/bin/env python3
"""Run terraform in this directory with the cog's secrets read from Doppler.

    ./tf plan -out tfplan
    ./tf apply tfplan

Why this exists: the secrets live in Doppler, and every other route to
Terraform failed on the first day. Copying them into terraform.tfvars
shipped the example's placeholders; pasting them through the clipboard lost
them to the next copy; exporting TF_VAR_* by hand lost them to an `unset`
in the same paste. This reads them from `doppler secrets download` straight
into terraform's environment, so they never touch the clipboard, the shell
history or a file other than the state and plan Terraform itself writes.

One-time per machine, in this directory:

    doppler setup --project <deejay-cog project> --config prd

(or set DOPPLER_PROJECT / DOPPLER_CONFIG for a single run). Nothing secret
is printed: only which names were found and how large the Google JSON is.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

#: Doppler name -> required. The Terraform variable is the name lowercased,
#: which is also what makes `doppler run --name-transformer tf-var` work.
SECRETS = {
    "DEEJAY_COG_API_KEY": True,
    "GOOGLE_CREDENTIALS_JSON": True,
    "SPOTIPY_CLIENT_ID": False,
    "SPOTIPY_CLIENT_SECRET": False,
    "SPOTIPY_REFRESH_TOKEN": False,
    "SPOTIFY_RADIO_PLAYLIST_ID": False,
    "SENTRY_DSN": False,
}


def fail(message: str) -> None:
    print(f"tf: {message}", file=sys.stderr)
    sys.exit(1)


def doppler_secrets() -> dict[str, str]:
    cmd = ["doppler", "secrets", "download", "--no-file", "--format", "json"]
    if os.environ.get("DOPPLER_PROJECT"):
        cmd += ["--project", os.environ["DOPPLER_PROJECT"]]
    if os.environ.get("DOPPLER_CONFIG"):
        cmd += ["--config", os.environ["DOPPLER_CONFIG"]]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    except FileNotFoundError:
        fail("the doppler CLI is not installed")
    except subprocess.CalledProcessError as exc:
        fail(
            "doppler could not read secrets. Run once in this directory:\n"
            "    doppler setup --project <deejay-cog project> --config prd\n"
            f"doppler said: {exc.stderr.strip()}"
        )
    return json.loads(out)


def google_json(raw: str) -> str:
    """Canonical, compact JSON. Tolerates real newlines inside the key.

    Doppler hands the private key back with literal line breaks, which
    strict JSON — Terraform's jsondecode and the Google client both — rejects.
    Parsing leniently and re-serialising escapes them without changing the key.
    """
    try:
        info = json.loads(raw, strict=False)
    except ValueError as exc:
        fail(f"GOOGLE_CREDENTIALS_JSON is not JSON: {exc}")
    if info.get("type") != "service_account" or "private_key" not in info:
        fail("GOOGLE_CREDENTIALS_JSON is not a service-account key")
    return json.dumps(info, separators=(",", ":"))


def overridden_in_tfvars() -> list[str]:
    """Secrets also set in terraform.tfvars, which would silently win."""
    tfvars = HERE / "terraform.tfvars"
    if not tfvars.exists():
        return []
    declared = set(re.findall(r"^\s*(\w+)\s*=", tfvars.read_text(), re.M))
    return sorted(name.lower() for name in SECRETS if name.lower() in declared)


def main() -> None:
    if len(sys.argv) < 2:
        fail("usage: ./tf plan -out tfplan   |   ./tf apply tfplan")

    clashes = overridden_in_tfvars()
    if clashes:
        fail(
            "terraform.tfvars sets " + ", ".join(clashes) + ". Remove them: "
            "tfvars wins over the environment, so they would override Doppler."
        )

    secrets = doppler_secrets()
    env = dict(os.environ)
    env.setdefault("AWS_PROFILE", "miniapppolis")

    for name, required in SECRETS.items():
        value = secrets.get(name, "")
        if not value:
            if required:
                fail(f"Doppler has no {name}")
            print(
                f"tf: {name:<26} not in Doppler (optional; the variable's default applies)"
            )
            continue
        if name == "GOOGLE_CREDENTIALS_JSON":
            value = google_json(value)
            print(f"tf: {name:<26} ok, {len(value)} bytes")
        else:
            print(f"tf: {name:<26} ok")
        env[f"TF_VAR_{name.lower()}"] = value

    args = sys.argv[1:]
    # Never prompt: a prompt means a variable did not arrive, and typing a
    # secret into it is how this process went wrong in the first place.
    if (
        args[0] in {"plan", "apply", "destroy", "refresh", "import"}
        and "-input=false" not in args
    ):
        args.insert(1, "-input=false")
    # exec replaces this process, so anything still buffered is lost.
    sys.stdout.flush()
    os.execvpe("terraform", ["terraform", *args], env)


if __name__ == "__main__":
    main()
